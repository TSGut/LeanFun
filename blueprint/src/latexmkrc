$pdf_mode = 1;
$out_dir = '../print';
@default_files = ('print.tex');
$pdflatex = 'pdflatex -interaction=nonstopmode -halt-on-error %O %S';
# Version string for the title page (scripts/version.py); empty if Python or Git is missing.
